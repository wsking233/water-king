# Copy to .env.local. Only the public publishable key belongs in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Validation only; keep disabled for production until Auth and lifecycle acceptance.
VITE_CLOUD_SYNC_PREVIEW=false

# Enable only for email-template and real Auth acceptance.
VITE_EMAIL_AUTH_PREVIEW=false
