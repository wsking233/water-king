{
  "name": "water-king",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test:lifecycle": "npm run lifecycle:generate && node scripts/test-lifecycle.mjs",
    "lifecycle:generate": "node --experimental-strip-types scripts/render-lifecycle.ts",
    "test:browser": "node scripts/browser-sync.mjs",
    "schema:generate": "node --experimental-strip-types scripts/render-schema.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:email-browser": "node scripts/browser-email.mjs",
    "release:check": "node scripts/check-release.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "test:goal-history": "node scripts/test-goal-history.mjs",
    "test:leaderboard": "node scripts/test-leaderboard.mjs",
    "test:leaderboard-browser": "node scripts/browser-leaderboard.mjs",
    "test:goal-browser": "node scripts/browser-goal-history.mjs",
    "test:achievements": "node scripts/test-achievements.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "6.2.4",
    "playwright-core": "1.61.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
